{
  "name": "fb-reel-to-watch",
  "version": "1.0.0",
  "description": "Chrome & Edge extension that automatically bypasses Facebook Reels and redirects to the classic Facebook Watch player.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "chrome-extension",
    "edge-extension",
    "facebook",
    "reels",
    "watch",
    "manifest-v3",
    "vite",
    "crxjs",
    "react",
    "tailwindcss"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
